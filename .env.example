# Copy to .env and fill in. Never commit the real .env.

# database and port
DB=mongodb://127.0.0.1:27017/crm
PORT=3000

# ---- mail (password reset codes and the hourly smart-view email) ----
# Mail server and the address mails are sent from.
MAIL_SERVER=
SENDER_EMAIL=
# The password of SENDER_EMAIL. Set this on the server: until it is set the app
# falls back to the old password that is still written in the source code.
MAIL_PASSWORD=
# Optional. Defaults: port 465 with TLS.
# MAIL_PORT=465
# MAIL_SECURE=true

# ---- hourly smart-view email ----
# The hourly job only runs where MAIL_SERVER and SENDER_EMAIL are both set, so a
# developer's computer without them never sends. Set to true to switch the job
# off even where mail is configured (for example a staging copy of the live data).
# REPORT_MAIL_DISABLED=false
